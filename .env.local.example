# Copy to .env.local (git-ignored) and restart `npm run dev` after any change.
# NEXT_PUBLIC_* values are inlined into the JS bundle at build/dev start.

# Same machine: Laravel via `php artisan serve` (127.0.0.1:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- LAN / another device -------------------------------------------------
# Backend:  php artisan serve --host=0.0.0.0 --port=8000
#           (and allow TCP 8000 in Windows Firewall)
# Frontend: browse to http://192.168.117.86:3000 from the other device.
# NEXT_PUBLIC_API_URL=http://192.168.117.86:8000/api
# Hosts allowed to load the dev server, comma-separated, no scheme or port:
# NEXT_DEV_ALLOWED_ORIGINS=192.168.117.86
